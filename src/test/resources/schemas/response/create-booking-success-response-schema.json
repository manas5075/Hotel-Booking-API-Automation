{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "bookingid": {
      "type": "integer",
      "example": 10
    },
    "booking": {
      "type": "object",
      "required": [
        "roomid",
        "firstname",
        "lastname",
        "depositpaid",
        "bookingdates",
        "email",
        "phone"
      ],
      "properties": {
        "roomid": {
          "type": "integer",
          "example": 2
        },
        "firstname": {
          "type": "string",
          "example": "John"
        },
        "lastname": {
          "type": "string",
          "example": "Doe"
        },
        "depositpaid": {
          "type": "boolean",
          "example": true
        },
        "bookingdates": {
          "type": "object",
          "properties": {
            "checkin": {
              "type": "string",
              "format": "date",
              "example": "2025-10-13"
            },
            "checkout": {
              "type": "string",
              "format": "date",
              "example": "2025-10-15"
            }
          }
        },
        "email": {
          "type": "string",
          "format": "email",
          "example": "john.doe@example.com"
        },
        "phone": {
          "type": "string",
          "example": "1234567890"
        }
      }
    }
  }
}
